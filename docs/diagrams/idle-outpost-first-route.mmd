flowchart LR
    Preconditions[existing data + logged in]
    Preconditions --> Ready[app-ready]
    Ready --> Main[main-screen]
    Main --> Entry[tap main.terrain.upgrade.entry]
    Entry --> Available[terrain-upgrade-first-available]
    Available --> First[tap terrain.upgrade.first]
    First --> Owned[terrain-upgrade-owned]
    Owned --> Evidence[after-first-upgrade screenshot]
    Owned --> Next[tap terrain.upgrade.next\naccountPolicy: preserve]
    Next --> SecondOwned[terrain-upgrade-second-owned]
    SecondOwned --> SecondEvidence[after-second-upgrade screenshot]
    SecondOwned --> Third[tap visible 57-coin row\nUpgradeId=4]
    Third --> ThirdOwned[terrain-upgrade-third-owned\n320-coin row remains]
    ThirdOwned --> ThirdEvidence[after-third-visible-upgrade screenshot]
    ThirdOwned --> Fourth[tap remaining 320-coin row\nUpgradeId=3\nexplicit authorization]
    Fourth --> FourthOwned[terrain-upgrade-fourth-owned]
