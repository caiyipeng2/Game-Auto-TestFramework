{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-auto-test-framework.dev/schemas/route.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "adapter", "steps"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "accountPolicy": {
      "enum": ["reset-existing", "preserve"]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context"],
        "properties": {
          "context": {
            "enum": [
              "clean-data",
              "existing-data",
              "account-ready",
              "logged-in"
            ]
          },
          "value": {}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "step": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["tap"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "tap": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["target"],
                  "properties": {
                    "target": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["wait"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "wait": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state"],
                  "properties": {
                    "state": { "type": "string", "minLength": 1 },
                    "timeoutMs": { "type": "integer", "minimum": 0 },
                    "pollIntervalMs": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["assert"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "assert": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state"],
                  "properties": {
                    "state": { "type": "string", "minLength": 1 },
                    "field": { "type": "string", "minLength": 1 },
                    "equals": {},
                    "notEquals": {},
                    "exists": { "type": "boolean" },
                    "contains": {}
                  },
                  "oneOf": [
                    { "required": ["equals"] },
                    { "required": ["notEquals"] },
                    { "required": ["exists"] },
                    { "required": ["contains"] }
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["screenshot"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "screenshot": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": { "name": { "type": "string", "minLength": 1 } }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "install": { "type": "object", "additionalProperties": false },
                "clearData": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "packageId": { "type": "string", "minLength": 1 }
                  }
                },
                "launch": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "packageId": { "type": "string", "minLength": 1 },
                    "activity": { "type": "string", "minLength": 1 }
                  }
                },
                "swipe": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["start", "end"],
                  "properties": {
                    "start": { "$ref": "#/$defs/point" },
                    "end": { "$ref": "#/$defs/point" },
                    "durationMs": { "type": "integer", "minimum": 0 }
                  }
                },
                "input": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text"],
                  "properties": { "text": { "type": "string" } }
                },
                "collectLogcat": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "name": { "type": "string", "minLength": 1 } }
                },
                "collectPerformance": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "name": { "type": "string", "minLength": 1 } }
                },
                "repeat": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["times", "steps"],
                  "properties": {
                    "times": { "type": "integer", "minimum": 1 },
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "$ref": "#/$defs/step" }
                    }
                  }
                },
                "branch": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["condition", "then"],
                  "properties": {
                    "condition": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["state"],
                      "properties": {
                        "state": { "type": "string", "minLength": 1 }
                      }
                    },
                    "then": {
                      "type": "array",
                      "items": { "$ref": "#/$defs/step" }
                    },
                    "else": {
                      "type": "array",
                      "items": { "$ref": "#/$defs/step" }
                    }
                  }
                }
              },
              "oneOf": [
                { "required": ["install"] },
                { "required": ["clearData"] },
                { "required": ["launch"] },
                { "required": ["swipe"] },
                { "required": ["input"] },
                { "required": ["collectLogcat"] },
                { "required": ["collectPerformance"] },
                { "required": ["repeat"] },
                { "required": ["branch"] }
              ]
            }
          ]
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    }
  }
}
